{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForkScopeReport",
  "description": "Full ForkScope report.",
  "type": "object",
  "required": [
    "dependencies",
    "diff",
    "duration_seconds",
    "fork",
    "generated_at",
    "options",
    "recommendations",
    "reference",
    "schema_version",
    "secrets",
    "security",
    "source",
    "timeline",
    "tool",
    "warnings"
  ],
  "properties": {
    "dependencies": {
      "$ref": "#/definitions/DependencyReport"
    },
    "diff": {
      "$ref": "#/definitions/DiffSection"
    },
    "duration_seconds": {
      "type": "number",
      "format": "double"
    },
    "fork": {
      "description": "Analysed fork repository.",
      "allOf": [
        {
          "$ref": "#/definitions/ClientInfo"
        }
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "history": {
      "anyOf": [
        {
          "$ref": "#/definitions/HistoryAnalysis"
        },
        {
          "type": "null"
        }
      ]
    },
    "options": {
      "$ref": "#/definitions/ReportOptions"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference": {
      "$ref": "#/definitions/ReferenceResult"
    },
    "schema_version": {
      "type": "string"
    },
    "secrets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SecretFinding"
      }
    },
    "security": {
      "$ref": "#/definitions/SecuritySection"
    },
    "source": {
      "description": "Source (original) repository.",
      "allOf": [
        {
          "$ref": "#/definitions/UpstreamInfo"
        }
      ]
    },
    "timeline": {
      "description": "Key dates and divergence graph.",
      "allOf": [
        {
          "$ref": "#/definitions/Timeline"
        }
      ]
    },
    "tool": {
      "$ref": "#/definitions/ToolInfo"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "BehindInfo": {
      "description": "How far the fork is behind a source branch.",
      "type": "object",
      "required": [
        "branch",
        "commits_behind"
      ],
      "properties": {
        "branch": {
          "type": "string"
        },
        "commits_behind": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      }
    },
    "BranchInfo": {
      "description": "Local branch of the fork.",
      "type": "object",
      "required": [
        "commit",
        "commits_not_in_head",
        "commits_not_in_source",
        "divergent",
        "is_head",
        "name"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "commits_not_in_head": {
          "description": "Commits missing from the fork's HEAD.",
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "commits_not_in_source": {
          "description": "Commits missing from the source.",
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "divergent": {
          "description": "Divergent branch: contains specific work not integrated into HEAD.",
          "type": "boolean"
        },
        "is_head": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "Candidate": {
      "description": "Score of a candidate commit (estimation).",
      "type": "object",
      "required": [
        "added",
        "commit",
        "deleted",
        "identical",
        "manifests_identical",
        "manifests_total",
        "modified",
        "moved",
        "refs",
        "score"
      ],
      "properties": {
        "added": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "commit": {
          "type": "string"
        },
        "content_similarity": {
          "description": "Average similarity of the modified files (fine phase).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "deleted": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "identical": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "manifests_identical": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "manifests_total": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "modified": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "moved": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "score": {
          "type": "number",
          "format": "double"
        },
        "structure_similarity": {
          "description": "Structure similarity (directories).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "Category": {
      "description": "Finding category.",
      "type": "string",
      "enum": [
        "authentication",
        "authorization",
        "cryptography",
        "input_validation",
        "configuration",
        "dependencies",
        "secrets",
        "other"
      ]
    },
    "Certainty": {
      "description": "Certainty level.",
      "oneOf": [
        {
          "description": "Ancestry relation verified by Git.",
          "type": "string",
          "enum": [
            "exact"
          ]
        },
        {
          "description": "Statistical estimate: never treat it as certain.",
          "type": "string",
          "enum": [
            "estimated"
          ]
        }
      ]
    },
    "ChangeOrigin": {
      "description": "Origin of a change.",
      "oneOf": [
        {
          "description": "Change written by the fork (the fork's own commits).",
          "type": "string",
          "enum": [
            "fork"
          ]
        },
        {
          "description": "Change present only in the working tree (uncommitted / untracked).",
          "type": "string",
          "enum": [
            "uncommitted"
          ]
        },
        {
          "description": "Content identical to a newer source version or another branch (backport).",
          "type": "string",
          "enum": [
            "source_newer"
          ]
        },
        {
          "description": "Content identical to a source version older than the reference (rollback).",
          "type": "string",
          "enum": [
            "source_older"
          ]
        },
        {
          "description": "Introduced by a fork commit copied from a source commit (cherry-pick).",
          "type": "string",
          "enum": [
            "source_cherry_pick"
          ]
        },
        {
          "description": "Undetermined origin (e.g. merge resolution).",
          "type": "string",
          "enum": [
            "undetermined"
          ]
        }
      ]
    },
    "ChangeStatus": {
      "description": "Status of a file relative to the reference.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "added",
            "deleted",
            "modified",
            "identical"
          ]
        },
        {
          "description": "File name changed (possibly also moved).",
          "type": "string",
          "enum": [
            "renamed"
          ]
        },
        {
          "description": "Same name, different directory.",
          "type": "string",
          "enum": [
            "moved"
          ]
        }
      ]
    },
    "ClientInfo": {
      "type": "object",
      "required": [
        "files",
        "is_git",
        "mode",
        "path",
        "shallow"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_git": {
          "type": "boolean"
        },
        "mode": {
          "$ref": "#/definitions/ClientMode"
        },
        "path": {
          "type": "string"
        },
        "shallow": {
          "type": "boolean"
        }
      }
    },
    "ClientMode": {
      "description": "Situation of the fork.",
      "oneOf": [
        {
          "description": "Git history descending from the source.",
          "type": "string",
          "enum": [
            "git_history"
          ]
        },
        {
          "description": "Git repository with no commit in common with the source (rewritten/imported history).",
          "type": "string",
          "enum": [
            "rewritten_history"
          ]
        },
        {
          "description": "Git repository present but unreadable or empty.",
          "type": "string",
          "enum": [
            "git_history_unusable"
          ]
        },
        {
          "description": "Plain source directory.",
          "type": "string",
          "enum": [
            "no_git_metadata"
          ]
        },
        {
          "description": "History ignored on request (`--force-snapshot`).",
          "type": "string",
          "enum": [
            "forced_snapshot"
          ]
        }
      ]
    },
    "CommitInfo": {
      "description": "Commit specific to the fork.",
      "type": "object",
      "required": [
        "author",
        "author_date",
        "committer",
        "committer_date",
        "deletions",
        "files",
        "files_changed",
        "hash",
        "insertions",
        "is_merge",
        "message",
        "parents",
        "short",
        "subject"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "author_date": {
          "type": "string"
        },
        "committer": {
          "type": "string"
        },
        "committer_date": {
          "type": "string"
        },
        "deletions": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_changed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "hash": {
          "type": "string"
        },
        "insertions": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "is_merge": {
          "type": "boolean"
        },
        "max_severity": {
          "anyOf": [
            {
              "$ref": "#/definitions/Severity"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "short": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "suspicious": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SuspicionReason"
          }
        }
      }
    },
    "CommitLite": {
      "description": "Source commit (short form).",
      "type": "object",
      "required": [
        "date",
        "hash",
        "subject"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      }
    },
    "CommitSummary": {
      "description": "Commit summary.",
      "type": "object",
      "required": [
        "author",
        "author_date",
        "committer_date",
        "hash",
        "short",
        "subject"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "author_date": {
          "type": "string"
        },
        "committer_date": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      }
    },
    "Confidence": {
      "description": "Confidence level.",
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "DatedCommit": {
      "description": "Dated commit.",
      "type": "object",
      "required": [
        "author_date",
        "date",
        "hash",
        "short",
        "subject"
      ],
      "properties": {
        "author_date": {
          "description": "Author date (ISO 8601).",
          "type": "string"
        },
        "date": {
          "description": "Commit date (ISO 8601).",
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      }
    },
    "DepChange": {
      "description": "Change of a dependency.",
      "type": "object",
      "required": [
        "external",
        "kind",
        "name",
        "scope"
      ],
      "properties": {
        "external": {
          "description": "Git, URL or local path dependency (outside the official registry).",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/definitions/DepChangeKind"
        },
        "name": {
          "type": "string"
        },
        "new_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "new_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "old_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "old_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "DepChangeKind": {
      "description": "Kind of dependency change.",
      "type": "string",
      "enum": [
        "added",
        "removed",
        "version_changed",
        "source_changed"
      ]
    },
    "DepFormat": {
      "description": "Ecosystem / format of a dependency file.",
      "type": "string",
      "enum": [
        "cargo_toml",
        "cargo_lock",
        "package_json",
        "package_lock",
        "yarn_lock",
        "pnpm_lock",
        "requirements",
        "pyproject",
        "poetry_lock",
        "composer_json",
        "composer_lock",
        "pom_xml",
        "gradle",
        "go_mod",
        "go_sum",
        "gemfile",
        "gemfile_lock"
      ]
    },
    "DependencyReport": {
      "description": "Dependency summary.",
      "type": "object",
      "required": [
        "added",
        "external",
        "manifests",
        "removed",
        "source_changed",
        "version_changed"
      ],
      "properties": {
        "added": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "external": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "manifests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ManifestReport"
          }
        },
        "removed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "source_changed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "version_changed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      }
    },
    "DiffLine": {
      "description": "Line of a hunk.",
      "type": "object",
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "$ref": "#/definitions/LineKind"
        },
        "new_no": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "old_no": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0.0
        },
        "text": {
          "type": "string"
        }
      }
    },
    "DiffSection": {
      "type": "object",
      "required": [
        "files",
        "stats"
      ],
      "properties": {
        "files": {
          "description": "Differing files (identical files are only counted).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FileChange"
          }
        },
        "stats": {
          "$ref": "#/definitions/DiffStats"
        }
      }
    },
    "DiffStats": {
      "description": "Global diff statistics.",
      "type": "object",
      "required": [
        "added",
        "binary_changed",
        "deleted",
        "eol_only",
        "files_client",
        "files_reference",
        "identical",
        "lines_added",
        "lines_removed",
        "modified",
        "moved",
        "renamed"
      ],
      "properties": {
        "added": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "binary_changed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "by_origin": {
          "description": "Number of differing files per origin.",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint",
            "minimum": 0.0
          }
        },
        "deleted": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "eol_only": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "files_client": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "files_reference": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "fork_changes": {
          "description": "Differing files attributable to the fork (fork, uncommitted, undetermined).",
          "default": 0,
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "identical": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "lines_added": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "lines_removed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "modified": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "moved": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "renamed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        }
      }
    },
    "DiskChange": {
      "description": "Latest file modification observed on disk.",
      "type": "object",
      "required": [
        "date",
        "files",
        "path"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "files": {
          "description": "Number of fork files (modified, not deleted) whose date was read.",
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "path": {
          "type": "string"
        }
      }
    },
    "EdgeKind": {
      "description": "Kind of edge.",
      "oneOf": [
        {
          "description": "Continuation of a lane.",
          "type": "string",
          "enum": [
            "lane"
          ]
        },
        {
          "description": "Fork departure from the source.",
          "type": "string",
          "enum": [
            "branch_off"
          ]
        },
        {
          "description": "Integration (merge) of the source into the fork.",
          "type": "string",
          "enum": [
            "merge"
          ]
        }
      ]
    },
    "FileChange": {
      "description": "Change of a file.",
      "type": "object",
      "required": [
        "eol_only",
        "is_binary",
        "lines_added",
        "lines_removed",
        "mode_changed",
        "origin",
        "path",
        "status",
        "too_large",
        "untracked"
      ],
      "properties": {
        "commits": {
          "description": "Fork commits that touched this file.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diff_file": {
          "description": "Relative path of the `.diff` file generated in the output directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "eol_only": {
          "description": "Only line endings differ.",
          "type": "boolean"
        },
        "hunks": {
          "description": "Hunks (included in the JSON only with `--full-diff`).",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Hunk"
          }
        },
        "is_binary": {
          "type": "boolean"
        },
        "lines_added": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "lines_removed": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "mode_changed": {
          "description": "Type change (executable, symbolic link…).",
          "type": "boolean"
        },
        "new_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "new_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "old_path": {
          "description": "Former path (rename / move).",
          "type": [
            "string",
            "null"
          ]
        },
        "old_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "old_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "origin": {
          "description": "Origin of the change.",
          "allOf": [
            {
              "$ref": "#/definitions/ChangeOrigin"
            }
          ]
        },
        "origin_detail": {
          "description": "Explanation of the origin.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Path in the fork (or in the reference for a deleted file).",
          "type": "string"
        },
        "similarity": {
          "description": "Content similarity (0-1) with the reference version.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "source_commit": {
          "description": "Source commit the content comes from (if applicable).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/ChangeStatus"
        },
        "too_large": {
          "description": "File too large for a line diff.",
          "type": "boolean"
        },
        "untracked": {
          "description": "File not tracked by Git in the fork.",
          "type": "boolean"
        }
      }
    },
    "Finding": {
      "description": "Finding (a lead to investigate, not a confirmed vulnerability).",
      "type": "object",
      "required": [
        "category",
        "change",
        "confidence",
        "file",
        "id",
        "justification",
